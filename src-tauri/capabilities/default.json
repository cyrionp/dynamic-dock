{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the dock and the settings window",
  "windows": ["dock", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "updater:default",
    "process:allow-restart",
    "autostart:default"
  ]
}
