{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the dock, the settings window and the launcher",
  "windows": ["dock", "dock-*", "settings", "launcher"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "updater:default",
    "process:allow-restart",
    "autostart:default"
  ]
}
